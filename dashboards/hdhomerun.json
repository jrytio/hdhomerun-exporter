          "title": "Devices",
          "gridPos": {
            "h": 4,
            "w": 24,
            "x": 0,
            "y": 46
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "description": "A device that is down has no row here. A 10 Mbit or half-duplex link is flagged: it cannot carry several tuners at up to 19 Mbit/s each.",
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "hdhomerun_tuners{device_id=~\"$device_id\"} * on(device_id) group_left(hwmodel, firmware) hdhomerun_info{device_id=~\"$device_id\"} * on(device_id) group_left(link) hdhomerun_ethernet_link_info{device_id=~\"$device_id\"}",
              "legendFormat": "",
              "refId": "A",
              "instant": true,
              "range": false,
              "format": "table"
            }
