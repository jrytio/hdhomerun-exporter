      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "ss: raw strength. High strength with low quality means interference or multipath, not a weak signal. Tinted bands are for broadcast: below 75% is marginal, below 50% is poor (cable wants 90% and 80%).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "hdhomerun_tuner_signal_strength_percent{device_id=~\"$device_id\"}",
          "legendFormat": "{{device_id}} tuner {{tuner}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "transparent",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
